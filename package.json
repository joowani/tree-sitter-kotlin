{
  "name": "tree-sitter-kotlin",
  "version": "0.1.0",
  "description": "Kotlin grammar for tree-sitter",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joowani/tree-sitter-kotlin.git"
  },
  "license": "MIT",
  "author": {
    "name": "Joohwan Oh",
    "email": "joohwan.oh@outlook.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "kotlin"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.27.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "generate": "tree-sitter generate",
    "parse": "tree-sitter parse",
    "test": "tree-sitter test",
    "test:node": "node --test bindings/node/*_test.js",
    "vendor-fixtures": "node tools/vendor-fixtures.js",
    "vendor-jetbrains": "node tools/vendor-jetbrains-tests.js",
    "cross-validate": "node tools/cross-validation/main.js",
    "cross-validate:debug": "node tools/cross-validation/main.js --debug",
    "cross-validate:test": "vitest run --config tools/vitest.config.js"
  },
  "allowScripts": {
    "tree-sitter-cli@0.27.0": true,
    "tree-sitter@0.25.1": true,
    "fsevents": false
  }
}
